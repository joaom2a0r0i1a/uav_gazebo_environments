<?xml version="1.0"?>
<package format="3">
  <name>uav_gazebo_environments</name>
  <version>0.1.0</version>
  <description>Gazebo worlds and models for UAV exploration and 3D reconstruction simulations.</description>
  <maintainer email="joao.felix.mendes@tecnico.ulisboa.pt">Joao Mendes</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <!-- gazebo_ros_paths_plugin applies these inside gzserver so model and file URIs resolve. -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_media_path="${prefix}"/>
  </export>
</package>
